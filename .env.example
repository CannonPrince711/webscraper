# ============================================================================
#  Webscraper — environment template
#  Copy to `.env` (root) and fill in. Everything is OPTIONAL: with an empty
#  file the app boots in DEMO MODE (local JSON store, mock queue, no LLM).
# ============================================================================

# ---------------------------------------------------------------------------
# Core app
# ---------------------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
# 32+ char random string. Signs sessions, webhooks and internal callbacks.
# Generate: openssl rand -base64 32
APP_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# ---------------------------------------------------------------------------
# Supabase  (leave blank => demo mode with local JSON datastore)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. Bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Storage buckets used for HTML snapshots / screenshots / exports
SUPABASE_STORAGE_BUCKET_ARTIFACTS=artifacts
SUPABASE_STORAGE_BUCKET_EXPORTS=exports

# ---------------------------------------------------------------------------
# Python scraping engine (FastAPI)
# ---------------------------------------------------------------------------
ENGINE_URL=http://localhost:8000
# Shared secret between Next.js / worker and the engine (HMAC + bearer)
ENGINE_API_KEY=dev-engine-key-change-me
# Allow the engine to launch headless Chromium for JS-heavy pages.
# Requires `python -m playwright install chromium`.
ENGINE_ENABLE_BROWSER=true
ENGINE_MAX_CONCURRENCY=8
ENGINE_REQUEST_TIMEOUT_MS=30000
# Proxy pool (comma separated). Leave blank for direct connections.
ENGINE_PROXY_URLS=

# --- Decodo residential proxies (https://decodo.com) ------------------------
# A job stores only the *policy* ("decodo" or "decodo://?country=us"), never a
# password, so these live here and are read by the engine at fetch time.
# Decodo dashboard → Residential → Proxy setup → copy username + password.
DECODO_USERNAME=
DECODO_PASSWORD=
# Gateway and port. :7000 rotates on every request; sticky sessions ride in the
# username (the engine adds `-session-...-sessionduration-<min>` for you).
DECODO_ENDPOINT=gate.decodo.com:7000
# Fallback country when a job does not name one (ISO-3166 alpha-2). Blank = the
# account's default.
DECODO_COUNTRY=
# Default lifetime for `sticky` requests without an explicit duration (max 1440).
DECODO_SESSION_MINUTES=10
# Honour robots.txt by default (jobs can override per-job, with an audit trail)
ENGINE_RESPECT_ROBOTS=true

# ---------------------------------------------------------------------------
# Redis / BullMQ queue  (leave blank => jobs run inline in the Next.js process)
# ---------------------------------------------------------------------------
REDIS_URL=
QUEUE_PREFIX=webscraper
WORKER_CONCURRENCY=5
# Max pages fetched in parallel by the worker for a single crawl job
WORKER_CRAWL_CONCURRENCY=4

# ---------------------------------------------------------------------------
# AI provider — any OpenAI-compatible endpoint (OpenAI, Groq, Together,
# OpenRouter, Azure, local Ollama/LM Studio). Leave blank for heuristic mode.
# ---------------------------------------------------------------------------
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
# Hard ceiling so a runaway prompt can't burn your budget
AI_MAX_TOKENS_PER_JOB=120000
AI_MONTHLY_USD_LIMIT=25

# ---------------------------------------------------------------------------
# Limits / abuse protection
# ---------------------------------------------------------------------------
MAX_PAGES_PER_JOB=5000
MAX_CRAWL_DEPTH=6
MAX_REQUESTS_PER_MINUTE_PER_ORG=600
RATE_LIMIT_PER_DOMAIN_RPS=2

# ---------------------------------------------------------------------------
# Webhooks
# ---------------------------------------------------------------------------
# HMAC-SHA256 signature header: X-Webscraper-Signature
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_MAX_ATTEMPTS=5

# ---------------------------------------------------------------------------
# Scheduler
# ---------------------------------------------------------------------------
# Shared secret for POST /api/cron, which dispatches due schedules.
# Generate: openssl rand -base64 32. Without it the endpoint refuses to run in
# production (it would be an unauthenticated "start every due job" button).
CRON_SECRET=

# ---------------------------------------------------------------------------
# Observability (optional)
# ---------------------------------------------------------------------------
LOG_LEVEL=info
SENTRY_DSN=
